# Compartment where the instance will be created.
# Leave empty to use the tenancy (root compartment) from oci_config.
COMPARTMENT_OCID=

# Required unless you run:  ./venv/bin/python check_setup.py --create-network --write-settings
SUBNET_OCID=

# Leave empty to auto-detect and rotate through all availability domains.
AVAILABILITY_DOMAIN=

# Leave empty to auto-pick the latest Canonical Ubuntu 22.04/24.04 aarch64
# image compatible with VM.Standard.A1.Flex.
IMAGE_OCID=

# Always Free Ampere A1 allotment is 4 OCPU / 24 GB total per tenancy.
# Start smaller (e.g. OCPUS=1 MEMORY_GB=6) if 4/24 stays unavailable.
OCPUS=4
MEMORY_GB=24
BOOT_VOLUME_GB=50

SHAPE=VM.Standard.A1.Flex
DISPLAY_NAME=a1-stockholm-free

# Path to an SSH public key that will be installed on the instance.
# Leave empty to use /workspace/oci-a1/id_ed25519.pub or ~/.ssh/id_ed25519.pub.
SSH_PUBKEY_FILE=

# Seconds to wait after an "Out of host capacity" error. A small jitter is added.
RETRY_SECONDS=60

# Optional Telegram notifications (success / fatal errors only). Leave empty to skip.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
